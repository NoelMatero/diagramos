node_modules/
out/
# `npm pack` output, for checking what a release would contain.
/*.tgz
release/
coverage/
.env
.diagramos/
.DS_Store
*.log
test-results/
playwright-report/
.e2e/
.probe/
# The two bundles scripts/build-vendor.mjs writes on install; ~13 MB, never
# committed. The leading slash matters: an unanchored `vendor/` also matches
# src/engine/vendor/, whose hand-written entry points are the build's *input*.
# Ignoring those made a clean clone unbuildable — see .github/workflows/ci.yml.
/vendor/

# Scratch handoff notes for parallel sessions. Not documentation.
docs/handoff/

# Code graph output: precomputed by graphify, not committed.
# (sidecar metadata is also here; freshness is checked at check time)
graphify-out/

# Corpus clones for `npm run measure:licence`. A licence records the commit it
# was measured at, not a copy of somebody else's repository.
/.corpus/
